# Copie ce fichier en .env et renseigne AU MOINS une clé.

# Google Gemini (offre gratuite, sans carte bancaire) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modèle Gemini (optionnel)
# GEMINI_MODEL=gemini-3.5-flash

# Claude / Anthropic (payant) : https://console.anthropic.com
ANTHROPIC_API_KEY=

# Forcer un fournisseur si les deux clés sont présentes : gemini ou claude (optionnel)
# LLM_PROVIDER=gemini
